# Generate two independent secrets, for example: openssl rand -hex 24
# NEVER check real tokens or employee data into source control.
EMPLOYEE_API_TOKEN=REPLACE_WITH_UNIQUE_LONG_EMPLOYEE_TOKEN
REVIEWER_API_TOKEN=REPLACE_WITH_UNIQUE_LONG_REVIEWER_TOKEN
SQLITE_PATH=./reviewflow.db
BIND_ADDR=127.0.0.1:8080
AI_MODE=rules
# To enable approved Azure OpenAI instead of offline deterministic parser:
# AI_MODE=azure
# AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=YOUR_CHAT_MODEL_DEPLOYMENT
# AZURE_OPENAI_API_KEY=YOUR_APPROVED_KEY

# Optional LOCAL AI on your own laptop (requires Ollama, ~2.5GB model download):
# AI_MODE=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:4b-instruct
# The launcher automatically repairs missing/placeholder tokens; do not put real HR data in this POC.

# --- Review agent (runs the workflow automatically; a person still approves every review) ---
# AGENT_ENABLED=true          # false = every step is a manual button
# AGENT_AUTO_DELIVER=true     # false = stop after staging; send to Workday manually
# AGENT_POLL_SECONDS=10
# AGENT_MAX_ATTEMPTS=3        # automatic attempts per step before HR is asked to retry

# --- Teams form intake (Power Automate posts responses to /api/v1/intake/microsoft-forms) ---
# INTAKE_API_TOKEN=           # optional separate token for the flow, >=16 chars, rotate independently
# FORMS_DEFAULT_TEMPLATE=ANNUAL_REVIEW
# FORMS_DEFAULT_PERIOD=2026   # used when the form has no "Review period" question

# --- Teams notifications (a Teams "Workflows" webhook that posts cards to a channel) ---
# TEAMS_WEBHOOK_URL=https://....logic.azure.com/workflows/...   or ...powerplatform.com/...
# PUBLIC_BASE_URL=http://127.0.0.1:8080   # link used in Teams cards; must be reachable by reviewers
