# ReviewFlow live configuration template.
# Copy the values into your hosting platform's secret store (e.g. Azure Container Apps secrets).
# Do not commit a filled-in copy. Check it with:  reviewflow --check-config
# Each section names who provides the values. See docs/GO-LIVE.md for the full checklist.

# ---------------------------------------------------------------- Hosting (Azure / IT team)
BIND_ADDR=0.0.0.0:8080
SQLITE_PATH=/data/reviewflow.db
# DELETE is required when /data is a network share such as Azure Files. Run ONE replica only.
SQLITE_JOURNAL_MODE=DELETE
# Address reviewers use; Teams cards link here.
PUBLIC_BASE_URL=https://reviewflow.contoso.com

# ---------------------------------------------------------------- Sign-in (Entra ID admin)
# Requires Azure Container Apps / App Service built-in authentication with the Microsoft
# provider, "Allow unauthenticated access" (the app enforces sign-in itself, and Power
# Automate calls the intake endpoint with a token).
AUTH_MODE=entra
ENTRA_REVIEWER_ROLE=ReviewFlow.Reviewer
ENTRA_HR_ROLE=ReviewFlow.HR

# Shared tokens are still required at startup. In entra mode the reviewer token is not
# accepted for sign-in; the employee/intake tokens are only for creating reviews.
EMPLOYEE_API_TOKEN=<generate: openssl rand -hex 24>
REVIEWER_API_TOKEN=<generate: openssl rand -hex 24>
# Given to the Power Automate flow only. Rotate it independently.
INTAKE_API_TOKEN=<generate: openssl rand -hex 24>

# ---------------------------------------------------------------- AI summaries (IT security)
AI_MODE=azure
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=<your-chat-model-deployment>
AZURE_OPENAI_API_KEY=<key from Key Vault>
AZURE_OPENAI_API_VERSION=2024-10-21

# ---------------------------------------------------------------- Workday (Workday integration team)
WORKDAY_MODE=soap
# Full service URL for the operation's web service, including tenant and WWS version, e.g.
# https://wd2-impl-services1.workday.com/ccx/service/<tenant>/Talent/v44.0
WORKDAY_ENDPOINT=https://<host>.workday.com/ccx/service/<tenant>/<Service>/<version>
# Integration system user, usually written as ISU_Name@tenant
WORKDAY_USERNAME=<ISU user>@<tenant>
WORKDAY_PASSWORD=<from Key Vault>
WORKDAY_REQUEST_TEMPLATE=/app/workday/request-template.xml
# Response element holding the created review's reference.
WORKDAY_RECEIPT_ELEMENT=ID
WORKDAY_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------- Teams (M365 admin / HR)
# Workflows webhook for approval cards (a private channel limited to approvers).
TEAMS_WEBHOOK_URL=https://<...>.logic.azure.com/workflows/<...>
FORMS_DEFAULT_TEMPLATE=<Workday review template reference>
FORMS_DEFAULT_PERIOD=2026

# ---------------------------------------------------------------- Review agent (HR)
AGENT_ENABLED=true
AGENT_AUTO_DELIVER=true
AGENT_POLL_SECONDS=10
AGENT_MAX_ATTEMPTS=3
